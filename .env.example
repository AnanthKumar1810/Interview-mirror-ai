# Only set your Gnani key on this server. Never commit .env to GitHub.
GNANI_API_KEY=

# Optional: GitHub Personal Access Token (PAT) for candidate project analysis (raises rate limit to 5000/hr)
GITHUB_TOKEN=

# Optional: local LLM for more contextual coaching.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 'off' = deterministic guarded rubric. 'ollama' enables optional local
# semantic risk assessment, which is NOT human-calibrated.
IM_SEMANTIC_JUDGE=off

# Local prototype safety controls (per process, not distributed quotas).
IM_SESSION_TTL_SECONDS=86400
IM_PROVIDER_CALLS_PER_MINUTE=60

# SQLite persistent transcript storage (default: .data/interviewmirror.sqlite3)
IM_DATABASE_PATH=.data/interviewmirror.sqlite3
# Local demo permits anonymous sessions. REQUIRED for any public deployment:
IM_AUTH_REQUIRED=false
IM_ENV=development
# Generate securely: python -c "import secrets; print(secrets.token_urlsafe(48))"
IM_JWT_SECRET=
